            VALUE "FileDescription", "SF4Enhanced: rollback netcode for Ultra Street Fighter IV"
            VALUE "FileVersion", "0.1.4.0"
            VALUE "InternalName", "SF4Enhanced"
            VALUE "LegalCopyright", "Built on sf4e by Anthony Danducci. Street Fighter is a trademark of CAPCOM."
            VALUE "OriginalFilename", "SF4Enhanced.exe"
            VALUE "ProductName", "SF4Enhanced"
            VALUE "ProductVersion", "0.1.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
